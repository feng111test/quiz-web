{
  "name": "exam-quiz-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "题库刷题网页版：内置 2026 高考化学真题，支持题目校正，可单独发布",
  "scripts": {
    "dev": "node scripts/prepare-default-bank.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-default-bank.mjs && vite build",
    "build:quiz": "node scripts/prepare-default-bank.mjs && vite build --config vite.quiz.config.js",
    "preview:quiz": "vite preview --config vite.quiz.config.js --outDir dist-quiz --host 127.0.0.1",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "start:lan": "pwsh -NoProfile -File deploy/start-lan.ps1",
    "start:tunnel": "pwsh -NoProfile -File deploy/start-tunnel.ps1",
    "backup:db": "pwsh -NoProfile -File deploy/backup-db.ps1",
    "seed": "node server/seed-cli.js",
    "test": "node --test",
    "test:server": "node --test server/tests",
    "test:client": "node --test src/tests"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "3.10.1",
    "pdfjs-dist": "5.4.624"
  },
  "devDependencies": {
    "vite": "7.2.2"
  }
}
